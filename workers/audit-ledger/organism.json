{
  "$schema_version": 1,
  "service": "cryptophys-audit-ledger",
  "display_name": "Audit Ledger",
  "kind": "service",
  "deploy_unit": "control-plane",
  "access": true,
  "rollback": true,
  "drift": {
    "via": "rpc",
    "binding": "SVC_AUDIT_LEDGER"
  },
  "agents": [
    {
      "id": "audit-ledger",
      "display_name": "Audit Ledger AI Agent",
      "capabilities": [
        "audit.verify",
        "reports.publish",
        "memory.recall",
        "memory.remember"
      ],
      "tier_max": 1,
      "voter": true,
      "vote_binding": "VOTE_AUDIT_LEDGER"
    }
  ],
  "engines": [
    {
      "task": "categorize_event"
    }
  ]
}
