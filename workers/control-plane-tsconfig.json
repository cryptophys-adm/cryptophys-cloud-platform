{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "platform-registry/src/**/*.ts",
    "deployment-orchestrator/src/**/*.ts",
    "policy-engine/src/**/*.ts",
    "drift-detector/src/**/*.ts",
    "audit-ledger/src/**/*.ts",
    "recovery-manager/src/**/*.ts"
  ]
}
