{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "workers/platform-registry/src/**/*.ts",
    "workers/deployment-orchestrator/src/**/*.ts",
    "workers/policy-engine/src/**/*.ts",
    "workers/drift-detector/src/**/*.ts",
    "workers/audit-ledger/src/**/*.ts",
    "workers/recovery-manager/src/**/*.ts"
  ]
}
