{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": ["./control-plane-shared/node_modules/@types"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "control-plane-shared/src/**/*.ts",
    "control-plane-shared/test/**/*.ts",
    "platform-registry/src/**/*.ts",
    "deployment-orchestrator/src/**/*.ts",
    "platform-api/src/**/*.ts",
    "policy-engine/src/**/*.ts",
    "drift-detector/src/**/*.ts",
    "audit-ledger/src/**/*.ts",
    "recovery-manager/src/**/*.ts",
    "signal-engine/src/**/*.ts",
    "ai-kernel/src/**/*.ts",
    "console/src/**/*.ts",
    "home/src/**/*.ts"
  ]
}
