{
  "$schema_version": 1,
  "service": "cryptophys-ai-kernel",
  "display_name": "AI Kernel",
  "kind": "service",
  "deploy_unit": "control-plane",
  "access": true,
  "rollback": true,
  "drift": {
    "via": "rpc",
    "binding": "SVC_AI_KERNEL"
  },
  "agents": [
    {
      "id": "adr-steward",
      "display_name": "ADR Steward",
      "capabilities": [
        "adr.observe",
        "reports.publish"
      ],
      "tier_max": 1,
      "voter": false
    },
    {
      "id": "auditor",
      "display_name": "Platform Auditor",
      "capabilities": [
        "audit.verify",
        "reports.publish",
        "memory.recall",
        "memory.remember"
      ],
      "tier_max": 1,
      "voter": true
    },
    {
      "id": "evolver",
      "display_name": "Evolver",
      "capabilities": [
        "code.read",
        "code.propose"
      ],
      "tier_max": 2,
      "voter": false
    },
    {
      "id": "signal-analyst",
      "display_name": "Signal Analyst",
      "capabilities": [
        "signals.observe",
        "reports.publish",
        "memory.recall",
        "memory.remember"
      ],
      "tier_max": 1,
      "voter": false
    },
    {
      "id": "supervisor",
      "display_name": "Platform Supervisor",
      "capabilities": [
        "platform.observe",
        "recovery.propose",
        "memory.recall",
        "memory.remember",
        "consensus.propose"
      ],
      "tier_max": 1,
      "voter": true
    }
  ],
  "engines": [
    {
      "task": "chat_answer"
    },
    {
      "task": "chat_plan"
    },
    {
      "task": "council_position"
    },
    {
      "task": "council_rebuttal"
    },
    {
      "task": "council_synthesis"
    },
    {
      "task": "directive_draft"
    },
    {
      "task": "draft_adr_explanation"
    },
    {
      "task": "draft_audit_digest"
    },
    {
      "task": "draft_recovery_proposal"
    },
    {
      "task": "evolve_plan"
    },
    {
      "task": "evolve_write"
    }
  ]
}
